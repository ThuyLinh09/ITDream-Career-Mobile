<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="f"
            type="graduate.itdreams.android.ui.main.login.RequestForgetPasswordFragment" />

        <variable
            name="vm"
            type="graduate.itdreams.android.ui.main.login.RequestForgetPasswordViewModel" />

        <import type="android.view.View" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingBottom="24dp"
                android:onClick="hideKeyboard">
                <com.airbnb.lottie.LottieAnimationView
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_150sdp"
                    android:layout_marginTop="@dimen/_40sdp"
                    app:lottie_rawRes="@raw/forgot_password"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quên mật khẩu"
                    style="@style/Text_20_Bold_Black"
                    android:layout_margin="@dimen/_12sdp"/>
                <EditText
                    android:id="@+id/email"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    style="@style/Text_12_Normal_Black"
                    android:background="@drawable/bg_text_box_un_select"
                    android:hint="Nhập email của bạn"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:textColorHint="@color/text_hint"
                    android:drawableStart="@drawable/ic_mail"
                    android:drawablePadding="@dimen/_12sdp"
                    android:inputType="textEmailAddress"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:singleLine="true"
                    />

                <TextView
                    android:id="@+id/mgs_er_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_Error"
                    android:text="@string/err_email"
                    android:layout_gravity="start"
                    android:layout_marginStart="@dimen/_23sdp"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:visibility="gone"/>

                <TextView
                    style="@style/Text_12_Bold_White"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_24sdp"
                    android:background="@drawable/bg_btn_radius_25"
                    android:gravity="center"
                    android:onClick="@{v -> f.onForgetClick()}"
                    android:padding="@dimen/_6sdp"
                    android:text="Tạo lại mật khẩu" />

                <TextView
                    android:id="@+id/login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_12ssp"
                    android:text="Quay lại trang đăng nhập"
                    android:textColor="@color/text_app"
                    android:layout_marginTop="@dimen/_20sdp"/>
            </LinearLayout>

        </ScrollView>


    </RelativeLayout>
</layout>