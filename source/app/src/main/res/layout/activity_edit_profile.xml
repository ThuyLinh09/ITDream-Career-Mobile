<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="a"
            type="graduate.itdreams.android.ui.main.account.EditProfileActivity" />

        <variable
            name="vm"
            type="graduate.itdreams.android.ui.main.account.EditProfileViewModel" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            app:navigationIcon="@drawable/ic_back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@color/bg_app"
            app:title="Chỉnh sửa thông tin"
            style="@style/Text_16_Bold_Black"
            app:titleCentered="true"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/toolbar"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp"
                android:onClick="hideKeyboard">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/_50sdp"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_10sdp">

                    <ImageView
                        android:id="@+id/avatar"
                        android:layout_width="@dimen/_70sdp"
                        android:layout_height="@dimen/_70sdp"
                        android:src="@drawable/avatar"
                        android:layout_margin="@dimen/_12sdp"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Họ và tên"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:textColor="@color/text_black"
                    style="@style/Text_12_Bold_Edit"/>
                <EditText
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    style="@style/Text_12_Normal_Black"
                    android:background="@drawable/bg_white_stroke_gray"
                    android:hint="Họ và tên của bạn"
                    android:text="@{vm.fullname}"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:textColorHint="@color/text_hint"
                    android:singleLine="true"
                    />

                <TextView
                    android:id="@+id/mgs_er_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_Error"
                    android:text="@string/err_name"
                    android:layout_gravity="start"
                    android:layout_marginStart="@dimen/_23sdp"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:visibility="gone"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ngày sinh"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:textColor="@color/text_black"
                    style="@style/Text_12_Bold_Edit"/>
                <EditText
                    android:id="@+id/et_birthdate"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:background="@drawable/bg_white_stroke_gray"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:drawablePadding="@dimen/_12sdp"
                    android:singleLine="true"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    style="@style/Text_12_Normal_Black"
                    android:hint="Ngày sinh của bạn"
                    android:text="@{vm.birthday}"
                    android:textColorHint="@color/text_hint"
                    android:focusable="false"
                    android:clickable="true"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Username"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:textColor="@color/text_black"
                    style="@style/Text_12_Bold_Edit"/>
                <EditText
                    android:id="@+id/username"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    style="@style/Text_12_Normal_Black"
                    android:background="@drawable/bg_white_stroke_gray"
                    android:hint="Username"
                    android:text="@{vm.username}"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:textColorHint="@color/text_hint"
                    android:singleLine="true"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:textColor="@color/text_black"
                    style="@style/Text_12_Bold_Edit"/>
                <EditText
                    android:id="@+id/email"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    style="@style/Text_12_Normal_Black"
                    android:background="@drawable/bg_white_stroke_gray"
                    android:hint="VD: nguyenvana@gmail.com"
                    android:text="@{vm.email}"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:textColorHint="@color/text_hint"
                    android:inputType="textEmailAddress"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:singleLine="true"
                    />

                <TextView
                    android:id="@+id/mgs_er_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_Error"
                    android:text="@string/err_email"
                    android:layout_gravity="start"
                    android:layout_marginStart="@dimen/_23sdp"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:visibility="gone"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    style="@style/Text_12_Bold_White"
                    android:text="Cập nhật"
                    android:background="@drawable/bg_btn_radius_25"
                    android:gravity="center"
                    android:padding="@dimen/_6sdp"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:onClick="@{v -> a.onUpdateProfile()}"
                    android:layout_marginTop="@dimen/_24sdp"/>

            </LinearLayout>

        </ScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>