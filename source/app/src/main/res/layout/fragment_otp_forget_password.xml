<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="f"
            type="graduate.itdreams.android.ui.main.login.OTPForgetPasswordFragment" />

        <variable
            name="vm"
            type="graduate.itdreams.android.ui.main.login.OTPForgetPasswordViewModel" />

        <import type="android.view.View" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingBottom="24dp"
                android:onClick="hideKeyboard">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thay đổi mật khẩu"
                    style="@style/Text_16_Bold_Black"
                    android:layout_margin="@dimen/_12sdp"/>

                <EditText
                    android:id="@+id/otp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    style="@style/Text_12_Normal_Black"
                    android:background="@drawable/bg_text_box_un_select"
                    android:hint="Nhập mã OTP"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:textColorHint="@color/text_hint"
                    android:drawableStart="@drawable/lock"
                    android:drawablePadding="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:singleLine="true"
                    android:inputType="number"
                    />
                <TextView
                    android:id="@+id/mgs_er_otp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_Error"
                    android:text="@string/err_phone"
                    android:layout_gravity="start"
                    android:layout_marginStart="@dimen/_23sdp"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:visibility="gone"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    app:endIconMode="password_toggle"
                    app:hintEnabled="false">
                    <EditText
                        android:id="@+id/password"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        style="@style/Text_12_Normal_Black"
                        android:paddingHorizontal="@dimen/_12sdp"
                        android:textColorHint="@color/text_hint"
                        android:background="@drawable/bg_text_box_un_select"
                        android:drawableStart="@drawable/lock"
                        android:drawablePadding="@dimen/_12sdp"
                        android:hint="@string/password"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        />
                </com.google.android.material.textfield.TextInputLayout>


                <TextView
                    android:id="@+id/mgs_er_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_Error"
                    android:text="@string/err_password"
                    android:layout_gravity="start"
                    android:layout_marginHorizontal="@dimen/_23sdp"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:visibility="gone"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    app:endIconMode="password_toggle"
                    app:hintEnabled="false">
                    <EditText
                        android:id="@+id/re_password"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        style="@style/Text_12_Normal_Black"
                        android:background="@drawable/bg_text_box_un_select"
                        android:hint="@string/repassword"
                        android:paddingHorizontal="@dimen/_12sdp"
                        android:textColorHint="@color/text_hint"
                        android:drawableStart="@drawable/lock"
                        android:drawablePadding="@dimen/_12sdp"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/mgs_er_re_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_Error"
                    android:text="@string/err_password_3"
                    android:layout_gravity="start"
                    android:layout_marginStart="@dimen/_23sdp"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/tv_reset_otp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_20sdp"
                    android:textSize="@dimen/_12ssp"
                    android:text="Gửi lại OTP"
                    android:onClick="@{v -> f.onResetOtpClick()}"
                    android:textColor="@color/text_app"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/_12sdp"/>
                <TextView
                    style="@style/Text_12_Bold_White"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_24sdp"
                    android:background="@drawable/bg_btn_radius_25"
                    android:gravity="center"
                    android:onClick="@{v -> f.onChangePasswordClick()}"
                    android:padding="@dimen/_6sdp"
                    android:text="Đổi mật khẩu" />

                <TextView
                    android:id="@+id/login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_12ssp"
                    android:text="Quay lại trang đăng nhập"
                    android:textColor="@color/text_app"
                    android:layout_marginTop="@dimen/_20sdp"/>

            </LinearLayout>

        </ScrollView>


    </RelativeLayout>
</layout>