<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="f"
            type="graduate.itdreams.android.ui.main.register.VerifyOTPFragment" />

        <variable
            name="vm"
            type="graduate.itdreams.android.ui.main.register.VerifyOTPViewModel" />

        <import type="android.view.View" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xác thực OTP"
                    style="@style/Text_16_Bold_Black"
                    android:layout_margin="@dimen/_12sdp"/>


                <EditText
                    android:id="@+id/otp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    style="@style/Text_12_Normal_Black"
                    android:background="@drawable/bg_text_box_un_select"
                    android:hint="Nhập OTP"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:textColorHint="@color/text_hint"
                    android:drawableStart="@drawable/lock"
                    android:drawablePadding="@dimen/_12sdp"
                    android:inputType="number"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:singleLine="true"
                    />
                <TextView
                    android:id="@+id/mgs_er_re_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_Error"
                    android:text="Mã xác thực không đúng"
                    android:layout_gravity="start"
                    android:layout_marginStart="@dimen/_23sdp"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/btn_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    style="@style/Text_12_Bold_White"
                    android:text="Xác nhận"
                    android:onClick="@{v -> f.onConfirmClick()}"
                    android:background="@drawable/bg_btn_radius_25"
                    android:gravity="center"
                    android:padding="@dimen/_6sdp"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_24sdp"/>


                <View
                    android:layout_width="@dimen/_150sdp"
                    android:layout_height="@dimen/_2sdp"
                    android:background="@color/line_app"/>

                <TextView
                    android:id="@+id/tv_reset_otp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_12ssp"
                    android:text="Gửi lại OTP"
                    android:onClick="@{v -> f.onResetOtpClick()}"
                    android:textColor="@color/text_app"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:layout_margin="@dimen/_12sdp"/>
            </LinearLayout>

        </ScrollView>


    </RelativeLayout>
</layout>