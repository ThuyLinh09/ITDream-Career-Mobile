<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="@dimen/_10sdp"
    android:layout_marginStart="@dimen/_15sdp"
    android:layout_marginEnd="@dimen/_15sdp"
    android:padding="@dimen/_10sdp"
    android:orientation="vertical"
    android:background="@drawable/bg_green_stroke_green">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_logo"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            android:scaleType="fitCenter"
            app:strokeColor="@color/gray"
            app:strokeWidth="1dp"
            app:shapeAppearanceOverlay="@style/RoundedImageView"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvJobPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text_14_Bold_Black"
                android:text="Tên bài mô phỏng"
                android:maxLines="2"
                android:ellipsize="end"/>
            <TextView
                android:id="@+id/tvCompanyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text_12_Normal_Black"
                android:textColor="@color/text_gray"
                android:text="Tên tác giả"
                android:maxLines="1"
                android:ellipsize="end"/>
            <LinearLayout
                android:id="@+id/layoutProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_10_Normal_Black"
                    android:textColor="@color/black"
                    android:text="Tiến độ:"
                    android:maxLines="1"
                    android:ellipsize="end"/>
                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="@color/bg_btn"
                    android:progressBackgroundTint="@color/bg_btn"/>
                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_10_Normal_Black"
                    android:textColor="@color/black"
                    android:text="50%"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvEstimatedTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_2sdp"
                    android:layout_marginHorizontal="@dimen/_2sdp"
                    android:textColor="@color/text_green"
                    style="@style/Text_10_Bold_Black"
                    android:background="@drawable/bg_green_stroke_green_radius_20sdp"
                    android:text="1 -2 giờ"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <androidx.appcompat.widget.AppCompatRatingBar
                    android:id="@+id/ratingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_2sdp"
                    android:stepSize="0.2"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:rating="3.6"
                    android:progressTint="@color/star"
                    android:secondaryProgressTint="@color/star"
                    android:progressBackgroundTint="@color/star"
                    style="@style/Widget.AppCompat.RatingBar.Small"
                    />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>