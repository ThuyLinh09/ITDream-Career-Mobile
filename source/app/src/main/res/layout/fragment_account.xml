                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/bg_second"
                                android:layout_alignParentBottom="true"
                                android:layout_marginHorizontal="@dimen/_12sdp"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_45sdp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/_12sdp"
                                android:layout_centerVertical="true">

                                <ImageView
                                    android:layout_width="@dimen/_18sdp"
                                    android:layout_height="@dimen/_18sdp"
                                    android:src="@drawable/bag"
                                    android:layout_gravity="center"/>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="@dimen/_30sdp"
                                    style="@style/Text_12_Normal_Black"
                                    android:text="Về TopCv"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:layout_centerVertical="true"/>


                                <ImageView
                                    android:layout_width="@dimen/_18sdp"
                                    android:layout_height="@dimen/_18sdp"
                                    android:src="@drawable/bag"
                                    android:layout_gravity="center"
                                    android:layout_alignParentEnd="true"/>

                            </RelativeLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/bg_second"
                                android:layout_alignParentBottom="true"
                                android:layout_marginHorizontal="@dimen/_12sdp"/>
                        </RelativeLayout>

                    </LinearLayout>
                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Đăng xuất"
                        android:background="@color/bg_app"
                        android:layout_margin="@dimen/_10sdp"
                        android:onClick="@{v -> f.onLogoutClick()}"/>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_60sdp"
            android:layout_marginHorizontal="@dimen/_12sdp"
            android:background="@drawable/bg_white_radius_8sdp"

            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/_70sdp"
                android:layout_height="@dimen/_70sdp"
                android:layout_marginVertical="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_14sdp">

                <FrameLayout
                    android:layout_width="@dimen/_69sdp"
                    android:layout_height="@dimen/_69sdp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_avatar">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="@dimen/_50sdp"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/_1sdp">

                        <ImageView
                            android:id="@+id/ivAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/avatar"
                            android:layout_margin="@dimen/_12sdp"/>
                    </androidx.cardview.widget.CardView>

                </FrameLayout>

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginEnd="@dimen/_12sdp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_14_Bold_Black"
                    android:text="@{vm.fullName}"
                    />

                <TextView
                    android:id="@+id/email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_12_Normal_Black"
                    android:text="@{vm.email}"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chỉnh sửa thông tin"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:textColor="@color/text_app"
                    android:onClick="@{v -> f.onEditPrrofile()}"/>
            </LinearLayout>


        </LinearLayout>

    </FrameLayout>

</layout>