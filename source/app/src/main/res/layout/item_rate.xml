<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="@dimen/_10sdp"
    android:layout_marginStart="@dimen/_15sdp"
    android:layout_marginEnd="@dimen/_15sdp"
    android:orientation="horizontal">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        app:cardCornerRadius="@dimen/_40sdp"
        app:strokeWidth="@dimen/_1sdp"
        app:strokeColor="@color/bg_btn"
        >
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/_5sdp"
            android:src="@drawable/avatar"
            android:scaleType="fitCenter"/>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_6sdp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text_14_Bold_Black"
                    android:text="username"
                    android:maxLines="2"
                    android:ellipsize="end"/>
                <androidx.appcompat.widget.AppCompatRatingBar
                    android:id="@+id/rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/_2sdp"
                    android:stepSize="0.2"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:rating="3.6"
                    android:progressTint="@color/star"
                    android:secondaryProgressTint="@color/star"
                    android:progressBackgroundTint="@color/star"
                    style="@style/Widget.AppCompat.RatingBar.Small"
                    />
            </LinearLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <TextView
                android:layout_width="@dimen/_60sdp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:visibility="gone"
                android:text="22/12/2022 12:12:12"
                style="@style/Text_10_Normal_Black"
                android:textColor="@color/text_hint"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I can't believe this. I read about Excel, Power BI, and Tableau for this role, and now I'm seeing how these skills are useful."
            style="@style/Text_12_Normal_Black"
            android:textColor="@color/black"/>
    </LinearLayout>

</LinearLayout>